# Leave CONTENT_REPOSITORY unset to read pages from the local origin/ directory.
# Set it to serve them from a GitHub repository instead.

# CONTENT_REPOSITORY=owner/repository
# CONTENT_REF=main
# CONTENT_PATH=

# Optional. Without it the GitHub API allows 60 requests an hour per address and
# private repositories are unreachable.
# GITHUB_TOKEN=

# Multi-tenant routing. With ROOT_DOMAIN set, a subdomain is read as a GitHub
# login and that account's content repositories are served in place of the
# default content. Locally, subdomains of localhost resolve without any DNS
# setup, so raferdev.localhost:3111 works with the value below.

# ROOT_DOMAIN=localhost:3111
